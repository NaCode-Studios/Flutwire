# Files and directories created by pub and the Flutter tool. The lockfile is
# ignored because every package here is a library: a consumer resolves its own.
.dart_tool/
.packages
build/
pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
doc/api/
coverage/
.env*

# Editors and operating systems.
.idea/
*.iml
.vscode/
.DS_Store

# Machine-specific paths. local.properties carries the absolute path of the
# Android SDK, which is not something a repository should publish.
local.properties
.gradle/
.cxx/
captures/
*.keystore
*.jks
key.properties

# Generated by Xcode and CocoaPods.
Pods/
xcuserdata/
DerivedData/
.symlinks/
ephemeral/
Generated.xcconfig
flutter_export_environment.sh
